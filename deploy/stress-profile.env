# Cloud Run profile cho stress test 1500 req/s
# Usage: DEPLOY_PROFILE=stress IMAGE_TAG=stress-20260601 ./deploy/deploy.sh all

API_MIN_INSTANCES=2
API_MAX_INSTANCES=6
API_CPU=2
API_MEMORY=4Gi
API_CONCURRENCY=300
API_TIMEOUT=60

WORKER_MIN_INSTANCES=2
WORKER_MAX_INSTANCES=4
WORKER_CPU=1
WORKER_MEMORY=2Gi
WORKER_CONCURRENCY=100
WORKER_TIMEOUT=300

# Giảm latency publish (tắt ordering nếu subscription chưa bật ordering)
APP_PUBSUB_ORDERING_ENABLED=false
