# ── Database (Cloud SQL PostgreSQL) ──────────────────────────────────────────
DB_HOST=10.20.0.10
DB_PORT=5432
DB_NAME=parking_db
DB_USERNAME=parking_user
DB_PASSWORD=your_db_password

# ── Redis (Memorystore or self-hosted) ────────────────────────────────────────
REDIS_HOST=10.20.0.20
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC=reservation.created
GCP_PUBSUB_ENABLED=true
LOCAL_MODE=false

# ── JWT (parking-api only) ────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRATION_MS=86400000

# ── Server ports ──────────────────────────────────────────────────────────────
# parking-api
SERVER_PORT=8080
# parking-outbox listens on PORT=8081
# parking-worker listens on PORT=8082
